<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ClassroomLive</AssemblyName>
    <!-- 더블클릭했을 때 검은 콘솔 창이 뜨지 않게 한다. 터미널에서 실행하면
         HostConsole.TryAttach()가 부모 콘솔에 붙어 출력이 그대로 보인다. -->
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.2.4</Version>
    <AssemblyVersion>1.2.4.0</AssemblyVersion>
    <FileVersion>1.2.4.0</FileVersion>
    <Authors>Asau</Authors>
    <Company>Asau</Company>
    <Product>Classroom Live</Product>
    <Description>Visual Studio 코드를 같은 네트워크의 학생에게 공유합니다.</Description>
    <ApplicationIcon>..\..\assets\ClassroomLiveIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\ClassroomLiveIcon.png"
             Link="wwwroot\favicon.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- Web SDK는 publish 때만 wwwroot를 내보낸다. build 산출물로 바로 실행해도
         화면이 뜨도록 출력 폴더에도 복사한다. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
